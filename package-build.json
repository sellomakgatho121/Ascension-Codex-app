{
  "name": "ascension-codex-production",
  "version": "1.0.0",
  "description": "Production build configuration for Ascension Codex",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js --external:@neondatabase/serverless --external:ws",
    "db:push": "drizzle-kit push:pg",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "deploy": "npm run build && npm run db:push"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "@google/generative-ai": "^0.1.3",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "connect-pg-simple": "^9.0.1",
    "drizzle-orm": "^0.29.0",
    "drizzle-zod": "^0.5.1",
    "zod": "^3.22.4",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "drizzle-kit": "^0.20.0"
  }
}