# Ascension Codex — Environment Variables
#
# Copy this file to .env and fill in the values you need.
# All keys are OPTIONAL — the app runs in demo mode with MemStorage
# and local AI responses when env vars are absent.

# ─── Database ──────────────────────────────────────────────────────
# PostgreSQL connection string (Neon serverless recommended).
# If unset, the app falls back to in-memory storage (data resets on restart).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ─── AI / LLM ──────────────────────────────────────────────────────
# OpenAI-compatible endpoint for V.E.R.S. responses.
AI_API_KEY="your-api-key"
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o"

# ─── Voice ─────────────────────────────────────────────────────────
# ElevenLabs for text-to-speech and speech-to-text (premium voice quality).
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# ─── Runtime ──────────────────────────────────────────────────────
# Node environment. Use "development" for local dev, "production" for deploy.
NODE_ENV="development"
