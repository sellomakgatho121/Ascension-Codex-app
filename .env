# Development Environment Variables
# This file sets up the app to run in development mode with fallback storage

# Database URL (using a dummy URL to prevent startup errors, app will fallback to MemStorage)
DATABASE_URL="postgresql://temp:temp@localhost:5432/temp"

# AI API Keys (optional - uncomment and add your keys when needed)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Node Environment
NODE_ENV=development